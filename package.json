{
  "name": "nhl96-build",
  "version": "1.0.0",
  "description": "Build scripts for NHL 96 Genesis",
  "scripts": {
    "assets": "node tools/prebuild.js retail",
    "extractassets": "node tools/extractAssets96.js retail",
    "segmap": "python3 tools/make_segmap96.py --out output/segmap96_check.json",
    "asm": "build96.bat",
    "fixopcodes": "node tools/fixopcodes.js \"output\\\\obj\\\\nhl96 .lst\" output\\\\obj\\\\nhl96.bin && move /y output\\\\obj\\\\modified_nhl96.bin output\\\\",
    "build:retail": "node tools/build.js retail",
    "build:dev": "node tools/build.js dev",
    "verify:retail": "node tools/verifyRom.js output/modified_nhl96.bin retail",
    "clean": "node tools/build.js --clean"
  },
  "license": "ISC"
}
